# Swift / SwiftPM
.build/
.swiftpm/
*.xcodeproj
*.xcworkspace
DerivedData/

# Vendored whisper.cpp source + build artifacts (regenerated by Scripts/bootstrap.sh)
Vendor/

# Build output / packaged app
dist/
*.app

# Local models (downloaded at runtime into ~/Library/Application Support/Talkty/Models,
# which is outside the repo). *.bin covers any stray model blobs. NOTE: do NOT add a
# bare `Models/` here — it also matches the Sources/TalktyKit/Models source directory.
*.bin

.DS_Store

# Machine-local Claude Code permissions (the committed .claude/settings.json
# carries the shared hooks; local permission rules stay per-machine)
.claude/settings.local.json
